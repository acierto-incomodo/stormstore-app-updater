{
  "name": "stormstore",
  "version": "2.0.4112",
  "description": "Tienda de aplicaciones de StormGamesStudios",
  "author": "StormGamesStudios",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:stormvortex": "electron . --StormVortex",
    "start:2": "set NODE_NO_WARNINGS=1 && electron .",
    "build": "electron-builder",
    "update-check": "electron-updater"
  },
  "build": {
    "appId": "com.stormgamesstudios.stormstore-beta",
    "productName": "StormStore Beta",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "acierto-incomodo",
      "repo": "stormstore-app-updater"
    },
    "protocols": [
      {
        "name": "StormStore Beta",
        "schemes": [
          "stormstore"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/app.ico"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "include": "build/v2-installer.nsh",
      "differentialPackage": true
    },
    "extraResources": [
      "assets/extraFiles/7zr.exe"
    ],
    "files": [
      "package.json",
      "main.js",
      "preload.js",
      "apps.json",
      "files.apps.json",
      "renderer/**/*",
      "assets/**/*",
      "settings.json",
      "!assets/extraFiles/aspnetcore-runtime-8.0.23-win-x64.exe",
      "!assets/media/trailers/**/*",
      "!assets/apps-4096x4096/**/*",
      "!assets/apps-new-quality/**/*",
      "!assets/apps-old/**/*",
      "!assets/apps-original/**/*",
      "!assets/apps-to-make/**/*",
      "!setup/**/*",
      "!**/*.ps1",
      "!**/*.bat",
      "!**/*.txt",
      "!**/*.md",
      "!**/*.sh",
      "!package-*.json",
      "!hacer",
      "!apps.json.*",
      "!assets/apps/**/*",
      "!assets/apps-size/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "@equal-games/game-scanner": "^1.1.4",
    "@material/web": "^2.4.1",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.3",
    "extract-zip": "^2.0.1",
    "steam-path": "^1.0.2"
  }
}
